# Copier ce fichier en .env, puis remplir ces valeurs localement.
# Ne jamais partager votre clé API ou le dossier data/.
RESEND_API_KEY=
MAIL_FROM=
# Vérification obligatoire même en local (reste bloquée tant que l'envoi est indisponible).
# REQUIRE_EMAIL_VERIFICATION=1
# Facultatif : remplace le code admin stocké au démarrage si renseigné.
# Laisser vide pour conserver le code actuel et sa rotation dans le panneau.
ADMIN_PANEL_CODE=
# Connexion GitHub : alternative aux e-mails Resend.
# Callback : ORIGIN/api/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Vocal : STUN activé par défaut. Pour les réseaux restrictifs, relais coturn :
# TURN_URLS=["turn:relay.example.com:3478","turns:relay.example.com:5349"]
# TURN_SHARED_SECRET=
# Le secret partagé reste sur le serveur ; les clients reçoivent un accès valable 1 h.

# Cloudflare Realtime TURN (server-side secrets)
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
